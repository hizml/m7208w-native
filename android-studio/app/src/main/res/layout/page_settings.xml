<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp" android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="打印机 WiFi" android:textSize="15sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/wifiReadBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="读取WiFi" android:textSize="13sp"/>
        <Button android:id="@+id/wifiScanBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="扫描网络" android:textSize="13sp"/>
    </LinearLayout>
    <!-- 扫码配网(D2): 系统相机拍WiFi二维码 → ZXing解析自动填表 -->
    <Button android:id="@+id/wifiQrBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📷 扫码配网 (拍WiFi二维码)"
        android:textSize="13sp"/>
    <EditText android:id="@+id/newSSID" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="新SSID"/>
    <EditText android:id="@+id/newPass" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="新密码"/>
    <Spinner android:id="@+id/wifiEncSpinner" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Button android:id="@+id/wifiWriteBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="写入WiFi配置" android:textSize="13sp"/>
    <TextView android:id="@+id/wifiInfoText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="" android:textSize="12sp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="墨粉维护" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/tonerReadBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="读状态" android:textSize="13sp"/>
        <Button android:id="@+id/tonerContBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="尽粉继续印" android:textSize="13sp"/>
        <Button android:id="@+id/tonerResetBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="重置计数" android:textSize="13sp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="管理员密码" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <EditText android:id="@+id/adminOldPwd" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="当前密码(默认888888)"
        android:inputType="textPassword"/>
    <EditText android:id="@+id/adminNewPwd" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="新密码"
        android:inputType="textPassword"/>
    <Button android:id="@+id/adminPwdBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="修改管理员密码" android:textSize="13sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="设备" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/rebootBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="重启打印机" android:textSize="13sp"/>
        <Button android:id="@+id/refreshBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="刷新状态" android:textSize="13sp"/>
    </LinearLayout>

    <!-- 感光鼓/定影维护: drum_reset(sub=0x1a) / fusererror_reset(sub=0x0b) 9100设置帧 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/drumResetBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="复位感光鼓" android:textSize="13sp"/>
        <Button android:id="@+id/fuserResetBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="解除定影错误" android:textSize="13sp"/>
    </LinearLayout>

    <!-- 休眠时间: powersave 帧, 1~30分钟 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="休眠时间 (1~30分钟)" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/sleepEdit" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:inputType="number" android:hint="分钟"/>
        <Button android:id="@+id/sleepReadBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="读取" android:textSize="13sp"/>
        <Button android:id="@+id/sleepSetBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="保存" android:textSize="13sp"/>
    </LinearLayout>

    <!-- 热点AP: p2p-wifi 帧(开=6/关=1), SSID 1~32可打印, 密码 8~64 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="热点AP" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/hotChk" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="启用热点" android:textSize="13sp"/>
        <Button android:id="@+id/hotReadBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="读取状态" android:textSize="13sp"/>
    </LinearLayout>
    <EditText android:id="@+id/hotSSID" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="热点SSID (1~32位可打印字符)" android:inputType="text"/>
    <EditText android:id="@+id/hotPass" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="热点密码 (8~64位)" android:inputType="textPassword"/>
    <Button android:id="@+id/hotSetBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="应用热点设置" android:textSize="13sp"/>

    <!-- 打印微调: userconfig 帧, 偏移±6格(约0.5mm/格), 默认浓度±3, 低湿度 -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="打印位置微调" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/ucLeadingLabel" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="上边偏移: 0" android:textSize="13sp"/>
    <SeekBar android:id="@+id/ucLeadingSeek" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/ucSideLabel" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="左边偏移: 0" android:textSize="13sp"/>
    <SeekBar android:id="@+id/ucSideSeek" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView android:id="@+id/ucDensityLabel" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="默认浓度: 0" android:textSize="13sp"/>
    <SeekBar android:id="@+id/ucDensitySeek" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/ucHumidityChk" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="低湿度模式" android:textSize="13sp"/>
        <CheckBox android:id="@+id/ucBackDirtyChk" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="防背面脏污" android:textSize="13sp"/>
        <CheckBox android:id="@+id/ucCoolChk" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="强制降温" android:textSize="13sp"/>
        <Button android:id="@+id/ucReadBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="读取" android:textSize="13sp"/>
        <Button android:id="@+id/ucSetBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="写入" android:textSize="13sp"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:id="@+id/aboutText"
        android:text="M7208W Studio · arm64原生 · 独立复刻\n打印协议: LHPL逆向 · 扫描: 53010/53011 · 非联想官方"
        android:textSize="11sp" android:textColor="#999999" android:layout_marginTop="20dp"/>
</LinearLayout>
</ScrollView>
