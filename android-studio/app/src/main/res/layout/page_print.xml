<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="选择内容" android:textSize="13sp" android:textColor="#888888"/>
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="3" android:useDefaultMargins="true">
        <Button android:id="@+id/entryPhoto" android:text="🖼 照片" android:textSize="13sp"/>
        <Button android:id="@+id/entryPdf" android:text="📄 PDF" android:textSize="13sp"/>
        <Button android:id="@+id/entryTxt" android:text="📝 文本" android:textSize="13sp"/>
        <Button android:id="@+id/entryCert" android:text="🪪 证件打印" android:textSize="13sp"/>
        <Button android:id="@+id/entryOffice" android:text="📊 Office" android:textSize="13sp"/>
        <Button android:id="@+id/entryAny" android:text="📂 其他文件" android:textSize="13sp"/>
    </GridLayout>

    <!-- 预览卡 -->
    <LinearLayout android:id="@+id/previewCard" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:background="#FFFFFF" android:padding="10dp" android:layout_marginTop="12dp"
        android:visibility="gone">
        <TextView android:id="@+id/previewTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp" android:text="-"/>
        <ImageView android:id="@+id/printPreview" android:layout_width="match_parent"
            android:layout_height="320dp" android:scaleType="fitCenter"
            android:background="#EEEEEE" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <Button android:id="@+id/prevPage" android:text="◀" android:minWidth="0dp"
                android:padding="10dp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/pageIndicator" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:gravity="center" android:text="1/1" android:textSize="14sp"/>
            <Button android:id="@+id/nextPage" android:text="▶" android:minWidth="0dp"
                android:padding="10dp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="打印设置" android:textSize="13sp" android:textColor="#888888" android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner android:id="@+id/ppSpinner" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/mediaPSpinner" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Spinner android:id="@+id/nupPSpinner" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>
            <Spinner android:id="@+id/scalePSpinner" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="浓度" android:textSize="13sp"/>
            <SeekBar android:id="@+id/densityPSeek" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="6" android:progress="3"/>
            <CheckBox android:id="@+id/tonerSaveChk" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="省墨" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="份数" android:textSize="14sp"/>
            <Button android:id="@+id/copyMinus" android:text="−" android:minWidth="0dp"
                android:padding="12dp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView android:id="@+id/copyCount" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:gravity="center" android:text="1"
                android:textSize="16sp" android:textStyle="bold"/>
            <Button android:id="@+id/copyPlus" android:text="＋" android:minWidth="0dp"
                android:padding="12dp" android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/printGoBtn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🖨 开始打印"
            android:layout_marginTop="8dp" android:textSize="15sp"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
